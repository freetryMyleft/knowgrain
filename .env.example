# Local PostgreSQL host settings. Compose creates both the application and LightRAG databases.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=knowgrain
POSTGRES_PASSWORD=knowgrain-local
POSTGRES_DATABASE=lightrag
KNOWGRAIN_POSTGRES_DB=knowgrain
VAULT_ROOT=./data/vault
# Web selection is limited to immediate child folders of this server-side parent.
# Once bound, the application database persists the chosen root; VAULT_ROOT is initial only.
VAULT_PARENT_DIR=./data/vaults
MAX_UPLOAD_BYTES=20971520

# Local API. Keep the default loopback binding for a single-user installation.
API_HOST=127.0.0.1
API_PORT=8787
WEB_DIST_DIR=./apps/web/dist
TOKENIZER_CACHE_DIR=./data/tokenizers

# Ollama runs on the host by default; start the Ollama app before using the demo.
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen3.6:35b
LLM_CONTEXT_SIZE=16384
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKEN_SIZE=32768

LIGHTRAG_WORKING_DIR=./data/lightrag
LIGHTRAG_WORKSPACE=knowgrain
